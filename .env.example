# Runtime setting names. Never commit real values. Leave credentials empty for sample mode.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_LIST_ID=
CLOUDFLARE_RULESET_ID=

# Exactly two comma-separated hostnames are supported by the current UI.
JJ_LINKS_SOURCE_HOSTS=go.example.com,ai.example.com

# Required whenever live Cloudflare credentials are configured.
# Local sample sign-in uses seedy@sites.test and must never administer production.
JJ_LINKS_OWNER_EMAIL=you@example.com
