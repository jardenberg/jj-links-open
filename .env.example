# Deploy to Cloudflare discovers this secret. Enter its value only in Cloudflare.
# Leave it empty for the read-only local sample. Never commit real values.
CLOUDFLARE_API_TOKEN=

# Add ordinary runtime settings in Worker Settings > Variables and Secrets:
# CF_ACCESS_TEAM_DOMAIN: your-team.cloudflareaccess.com
# CF_ACCESS_AUD: the Access application's audience
# JJ_LINKS_OWNER_EMAIL: your exact allowed email
# CLOUDFLARE_ACCOUNT_ID: the selected Cloudflare account
# CLOUDFLARE_ZONE_ID: the zone containing your short hosts
# JJ_LINKS_SOURCE_HOSTS: exactly two comma-separated hosts
#                       e.g. go.example.com,ai.example.com
# Optional advanced pins: CLOUDFLARE_LIST_ID and CLOUDFLARE_RULESET_ID (both).
# Normally use the dashboard's Connect Cloudflare chooser instead of pins.
# Full instructions: docs/DEPLOYMENT.md
