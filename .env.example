# Never commit real values. Copy to .dev.vars for local Cloudflare development.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_LIST_ID=
CLOUDFLARE_RULESET_ID=

# Exactly two comma-separated hostnames are supported by the current UI.
JJ_LINKS_SOURCE_HOSTS=go.example.com,ai.example.com

# Optional defense in depth when deployed with Sign in with ChatGPT.
JJ_LINKS_OWNER_EMAIL=you@example.com
