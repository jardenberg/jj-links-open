{
  "name": "jj-links-open",
  "version": "1.0.2",
  "description": "A self-hosted control plane for Cloudflare Bulk Redirects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jardenberg/jj-links-open.git"
  },
  "bugs": {
    "url": "https://github.com/jardenberg/jj-links-open/issues"
  },
  "homepage": "https://github.com/jardenberg/jj-links-open#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "privacy-check": "node scripts/check-public-data.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261022.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.3.0",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "sharp": "0.35.5"
  }
}
